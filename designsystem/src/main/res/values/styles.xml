<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.FlightTracker.Display" parent="TextAppearance.AppCompat.Display1">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.FlightTracker.Headline" parent="TextAppearance.AppCompat.Headline">
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FlightTracker.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FlightTracker.TitleSmall" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FlightTracker.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FlightTracker.BodySecondary" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.FlightTracker.Subtitle" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FlightTracker.Caption" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FlightTracker.CaptionTiny" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FlightTracker.Overline" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.FlightTracker.Emphasis" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chip_text</item>
    </style>

    <style name="TextAppearance.FlightTracker.EmptyState" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.FlightTracker.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/ds_radius_lg</item>
        <item name="cardElevation">@dimen/ds_elevation_card</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="strokeWidth">@dimen/ds_stroke_hairline</item>
        <item name="strokeColor">@color/stroke_soft</item>
    </style>

    <style name="Widget.FlightTracker.Card.Low" parent="Widget.FlightTracker.Card">
        <item name="cardCornerRadius">@dimen/ds_radius_md</item>
        <item name="cardElevation">@dimen/ds_elevation_card_low</item>
    </style>

    <style name="Widget.FlightTracker.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_blue_round</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/ds_button_min_height</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.FlightTracker.Button.PrimaryCompact" parent="Widget.FlightTracker.Button.Primary">
        <item name="android:minHeight">@dimen/ds_button_min_height_compact</item>
    </style>

    <style name="Widget.FlightTracker.Button.Outlined" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_outline_round</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/ds_button_min_height_compact</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.FlightTracker.Button.DangerOutline" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_danger_round</item>
        <item name="android:textColor">@color/danger_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/ds_button_min_height_compact</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.FlightTracker.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.FlightTracker.Button.Outlined.Material" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/ds_radius_sm</item>
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="strokeWidth">@dimen/ds_stroke_hairline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
